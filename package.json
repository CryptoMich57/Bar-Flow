{
  "name": "barflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:reglas && npm run test:funciones",
    "test:reglas": "firebase emulators:exec --only firestore --project barflow-pruebas \"vitest run tests/reglas.test.js\"",
    "lint": "eslint .",
    "test:funciones": "firebase emulators:exec --only firestore,functions,auth --project barflow-pruebas \"vitest run tests/funciones.test.js\""
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "firebase-tools": "^15.28.1",
    "globals": "^15.14.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.9",
    "workbox-window": "^7.0.0"
  }
}
