rules_version = '2';

// ============================================================
//  REGLAS DE SEGURIDAD - BarFlow (SaaS multi-local)
//
//  Modelo de aislamiento:
//  - Cada negocio es un documento locales/{localId} y TODOS sus
//    datos cuelgan debajo. El localId viaja en el path, asi que
//    cada regla sabe de que negocio se trata sin confiar en el
//    cliente.
//  - El rol de una persona vive en locales/{localId}/empleados/{uid}.
//    Trabajar en el bar A no dice absolutamente nada sobre el bar B:
//    alla no hay ficha, y sin ficha no hay permiso. El aislamiento
//    es por construccion, no por un filtro que alguien pueda olvidar.
//  - El comensal entra con sesion anonima. No se registra, pero sin
//    sesion no toca nada.
//  - El admin de la plataforma (Hexa Group) esta en
//    superadmins/{uid}. Ese documento SOLO se crea desde la
//    consola de Firebase: nadie puede darse ese permiso a si mismo.
//
//  Roles de local: 'encargado' | 'cocina' | 'mozo'
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -- AYUDAS GENERALES -------------------------------------
    function logueado() {
      return request.auth != null;
    }

    function miUid() {
      return request.auth.uid;
    }

    // El dueno del SaaS. Ve y administra todo.
    function esAdminPlataforma() {
      return logueado()
        && exists(/databases/$(database)/documents/superadmins/$(miUid()));
    }

    // -- AYUDAS POR LOCAL -------------------------------------
    function refFicha(localId) {
      return /databases/$(database)/documents/locales/$(localId)/empleados/$(miUid());
    }

    function tieneFicha(localId) {
      return logueado() && exists(refFicha(localId));
    }

    function ficha(localId) {
      return get(refFicha(localId)).data;
    }

    function refDelLocal(localId) {
      return /databases/$(database)/documents/locales/$(localId);
    }

    // El local existe y no esta suspendido por falta de pago.
    function localActivo(localId) {
      return exists(refDelLocal(localId))
        && get(refDelLocal(localId)).data.estado in ['activo', 'prueba'];
    }

    // Trabaja en ESTE local, no esta dado de baja, y el local no esta
    // suspendido. Suspender congela el negocio para todos: comensales y
    // personal por igual. El unico que sigue entrando es la plataforma,
    // que es quien tiene que poder reactivarlo.
    function esPersonal(localId) {
      return tieneFicha(localId)
        && localActivo(localId)
        && ficha(localId).activo == true
        && ficha(localId).rol in ['encargado', 'cocina', 'mozo'];
    }

    function esEncargado(localId) {
      return tieneFicha(localId)
        && localActivo(localId)
        && ficha(localId).activo == true
        && ficha(localId).rol == 'encargado';
    }

    // El comensal es, literalmente, una sesion ANONIMA en un local que
    // esta funcionando. Antes esta funcion decia solo logueado(), lo que
    // convertia en "comensal" a cualquier cuenta con sesion: al personal
    // de otro bar y —peor— al admin de la plataforma, que asi podia
    // escribir mesas y pedidos de un negocio ajeno pese a que la UI le
    // escondia los botones. El proveedor de acceso lo firma Firebase y
    // no lo elige el cliente, asi que sirve como frontera real.
    function esComensal(localId) {
      return logueado()
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && localActivo(localId);
    }

    function esTitular(localId) {
      return logueado()
        && get(refDelLocal(localId)).data.owner_uid == miUid();
    }

    // El email verificado que trae el token de Google. Es la clave de
    // las invitaciones: nadie puede reclamar la de otra persona porque
    // el email no lo elige el cliente, lo firma el proveedor.
    function miEmail() {
      return request.auth.token.email;
    }

    function refInvitacion(localId, email) {
      return /databases/$(database)/documents/locales/$(localId)/invitaciones/$(email);
    }

    // ¿Me invitaron a este local con este rol exacto?
    function tengoInvitacion(localId, rol) {
      return logueado()
        && miEmail() != null
        && exists(refInvitacion(localId, miEmail()))
        && get(refInvitacion(localId, miEmail())).data.rol == rol;
    }

    // -- EL LOCAL ---------------------------------------------
    match /locales/{localId} {

      // Leer UN local por su id lo puede hacer cualquiera con sesion:
      // la pantalla de la mesa necesita el nombre y el logo antes de
      // que el comensal haga nada, y para eso ya tiene el id en el QR.
      allow get: if logueado();

      // Listar la coleccion, en cambio, es solo de la plataforma. Si
      // no se separa de 'get', un allow read deja que cualquiera
      // —hasta un comensal anonimo— se baje el padron completo de
      // negocios con sus dueños, planes y estados.
      allow list: if esAdminPlataforma();

      // Alta de un negocio nuevo: la hace la propia persona al
      // registrarse. Se exige que se declare duena de lo que crea y
      // que no pueda nacer con un estado que no le toca.
      allow create: if logueado()
        && request.resource.data.owner_uid == miUid()
        && request.resource.data.estado == 'prueba'
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0;

      // El encargado edita los datos de su local, pero NO puede
      // tocar quien es el titular, el plan ni el estado de la cuenta:
      // eso es de la plataforma.
      allow update: if esAdminPlataforma()
        || (esEncargado(localId)
            && request.resource.data.owner_uid == resource.data.owner_uid
            && request.resource.data.plan       == resource.data.plan
            && request.resource.data.estado     == resource.data.estado);

      // Dar de baja un negocio es cosa de la plataforma.
      allow delete: if esAdminPlataforma();

      // -- CARTA ----------------------------------------------
      match /carta/{itemId} {
        allow read:  if esComensal(localId) || esPersonal(localId) || esAdminPlataforma();
        // La plataforma NO edita la carta de un cliente. Soporte mira.
        allow write: if esEncargado(localId);
      }

      // -- CONFIGURACION DEL LOCAL ----------------------------
      // Datos de transferencia, mozos, cantidad de mesas.
      match /sistema/{docId} {
        allow read:  if esComensal(localId) || esPersonal(localId) || esAdminPlataforma();
        // Datos de transferencia y mozos son del negocio, no nuestros.
        allow write: if esEncargado(localId);
      }

      // -- MESAS ----------------------------------------------
      // Operar una mesa es del comensal sentado en ella y del personal
      // del local. La plataforma lee para dar soporte y nada mas.
      match /mesas/{mesaId} {
        allow read:           if esComensal(localId) || esPersonal(localId) || esAdminPlataforma();
        allow create, update: if esComensal(localId) || esPersonal(localId);
        allow delete:         if esEncargado(localId);

        match /pedidos/{pedidoId} {
          allow read:           if esComensal(localId) || esPersonal(localId) || esAdminPlataforma();
          allow create, update: if esComensal(localId) || esPersonal(localId);
          allow delete:         if esPersonal(localId);
        }

        match /mensajes/{mensajeId} {
          allow read:           if esComensal(localId) || esPersonal(localId) || esAdminPlataforma();
          allow create:         if esComensal(localId) || esPersonal(localId);
          allow update, delete: if esPersonal(localId);
        }

        match /llamadas/{llamadaId} {
          allow read:           if esComensal(localId) || esPersonal(localId) || esAdminPlataforma();
          allow create:         if esComensal(localId) || esPersonal(localId);
          allow update, delete: if esPersonal(localId);
        }
      }

      // -- HISTORIAL Y CAJA -----------------------------------
      // Facturacion cerrada: ningun comensal la ve ni la toca.
      // La caja del cliente se mira, no se toca: un cierre creado o borrado
      // por la plataforma seria plata movida sin que el negocio lo sepa.
      match /historial/{docId} {
        allow read:           if esPersonal(localId) || esAdminPlataforma();
        allow create:         if esPersonal(localId);
        allow update, delete: if esEncargado(localId);
      }

      // -- EMPLEADOS ------------------------------------------
      // Aca vive el rol de cada persona del local. Es lo que mira
      // todo el resto de las reglas, asi que es el punto sensible.
      match /empleados/{uid} {

        // Cada uno lee su ficha para saber que vista le toca; el
        // encargado lee y lista a todo su equipo.
        allow read: if (logueado() && uid == miUid())
          || esEncargado(localId)
          || esAdminPlataforma();

        // Tres formas legitimas de que nazca una ficha:
        //  1. el titular se anota a si mismo al registrar el local;
        //  2. alguien canjea la invitacion que le dejaron, y solo con
        //     el rol que dice esa invitacion —no el que el pida—;
        //  3. la plataforma, dando soporte.
        // El encargado NO crea fichas a mano: con Google no puede
        // crearle la cuenta a otro, asi que invita y la persona entra.
        // La plataforma tampoco reparte roles: si diera de alta un
        // encargado, tendria una puerta de entrada silenciosa a cualquier
        // negocio. Un cliente que se queda sin acceso se resuelve desde la
        // consola de Firebase, que si deja rastro en los audit logs.
        allow create: if (uid == miUid()
              && esTitular(localId)
              && request.resource.data.rol == 'encargado')
          || (uid == miUid()
              && tengoInvitacion(localId, request.resource.data.rol)
              && request.resource.data.activo == true);

        // El encargado administra a su equipo. No puede cambiarse el
        // rol a si mismo ni auto-desactivarse: evita que el local se
        // quede sin nadie que pueda administrarlo.
        allow update: if esEncargado(localId)
          && request.resource.data.rol in ['encargado', 'cocina', 'mozo']
          && (uid != miUid()
              || (request.resource.data.rol == resource.data.rol
                  && request.resource.data.activo == true));

        allow delete: if esEncargado(localId) && uid != miUid();
      }

      // -- INVITACIONES DEL LOCAL -----------------------------
      // El id del documento es el email invitado, en minusculas.
      match /invitaciones/{email} {
        // El encargado ve y administra las pendientes de su local.
        // La persona invitada lee la suya para saber que rol le toca.
        allow read: if esEncargado(localId)
          || esAdminPlataforma()
          || (logueado() && email == miEmail());

        allow create, update: if esEncargado(localId)
          && request.resource.data.rol in ['encargado', 'cocina', 'mozo'];

        // La borra el encargado (se arrepintio) o la propia persona
        // al canjearla. La plataforma no reparte invitaciones.
        allow delete: if esEncargado(localId)
          || (logueado() && email == miEmail());
      }
    }

    // -- INDICE GLOBAL DE INVITACIONES ------------------------
    // Un puntero minimo email -> local, para que quien entra por
    // primera vez sepa a que negocio lo invitaron. Cada uno solo
    // puede leer y borrar la suya: el email lo firma Google, no lo
    // elige el cliente, asi que nadie puede reclamar la de otro.
    match /invitaciones/{email} {
      allow get: if logueado() && email == miEmail();
      allow list: if esAdminPlataforma();

      // Solo un encargado puede dejar una invitacion, y solo apuntando
      // a su propio local.
      allow create: if esEncargado(request.resource.data.local_id);

      // Pisar un puntero que ya existe solo se permite si sigue siendo del
      // mismo local. Asi un encargado no puede robarle una invitacion
      // pendiente a otro negocio, y —importante— el cliente no necesita
      // LEER el documento para averiguarlo: si ya es de otro local, la
      // escritura se rechaza sola. Antes la app hacia ese chequeo con un
      // get() que las reglas le negaban, y el alta de personal moria ahi.
      allow update: if esEncargado(request.resource.data.local_id)
        && resource.data.local_id == request.resource.data.local_id;

      allow delete: if (logueado() && email == miEmail())
        || esEncargado(resource.data.local_id);
    }

    // -- INDICE GLOBAL uid -> local ---------------------------
    // Un documento minimo que dice a que local pertenece cada
    // cuenta, para saber a donde mandarla despues del login. El rol
    // que vale para los permisos es el de empleados/{uid}: este es
    // solo un atajo de navegacion.
    match /usuarios/{uid} {
      allow read: if (logueado() && uid == miUid()) || esAdminPlataforma();

      // Se escribe al registrarse (uno mismo) o cuando el encargado
      // da de alta a alguien de su local.
      allow create, update: if (uid == miUid() && request.resource.data.local_id is string)
        || esEncargado(request.resource.data.local_id);

      allow delete: if esEncargado(resource.data.local_id);
    }

    // -- ADMINS DE LA PLATAFORMA ------------------------------
    // Solo se crean desde la consola de Firebase. La app jamas
    // escribe aca: si esto fuera escribible, cualquiera podria
    // darse acceso a todos los negocios.
    match /superadmins/{uid} {
      allow read:  if logueado() && uid == miUid();
      allow write: if false;
    }

    // Todo lo que no este declarado arriba queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
