# Datos del proyecto de Firebase (consola > Configuracion del proyecto > Tus apps).
# Copiar este archivo a .env y completar. El .env NO se sube al repositorio.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Poner en 1 para que la app hable con los emuladores locales en vez del
# proyecto real. Solo funciona en desarrollo. Levantar antes:
#   firebase emulators:start --only firestore,functions,auth
VITE_USAR_EMULADORES=
