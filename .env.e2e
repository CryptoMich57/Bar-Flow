# ============================================================
#  ENTORNO DE LAS PRUEBAS DE RECORRIDO (AUD-014)
#
#  Apunta a los emuladores locales y al proyecto de pruebas, NUNCA al
#  proyecto real. Estos valores no son secretos: el emulador de Auth
#  acepta cualquier apiKey, y por eso este archivo si va al repositorio.
#
#  El proyecto tiene que ser el mismo que usan las otras suites
#  (barflow-pruebas) para que los tokens que emite el emulador valgan.
# ============================================================
VITE_FIREBASE_API_KEY=clave-de-emulador
VITE_FIREBASE_AUTH_DOMAIN=barflow-pruebas.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=barflow-pruebas
VITE_FIREBASE_STORAGE_BUCKET=barflow-pruebas.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:000000000000000000
VITE_USAR_EMULADORES=1
